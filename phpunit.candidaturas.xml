<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Candidaturas isoladas">
            <file>tests/Unit/CandidaturaToggleTest.php</file>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_KEY" value="0123456789abcdef0123456789abcdef" force="true"/>
        <env name="APP_URL" value="http://localhost" force="true"/>
        <env name="APP_CONFIG_CACHE" value=".test-runtime/candidaturas-config.php" force="true"/>
        <env name="APP_ROUTES_CACHE" value=".test-runtime/candidaturas-routes.php" force="true"/>
        <env name="APP_EVENTS_CACHE" value=".test-runtime/candidaturas-events.php" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
    </php>
</phpunit>
